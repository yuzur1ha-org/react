{
  "name": "@yuzur1ha/docs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "yupress dev --port 5173",
    "build": "yupress build && node scripts/copy-licenses.mjs",
    "preview": "yupress preview --port 5173",
    "typecheck": "tsc -p tsconfig.json",
    "test:e2e": "pnpm -w test:e2e",
    "content:generate": "yupress generate",
    "content:check": "yupress check",
    "test": "pnpm -w test:unit --project=docs",
    "test:pages": "pnpm -w test:pages"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@yuzur1ha/token": "workspace:*",
    "@yuzur1ha/ui": "workspace:*",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0",
    "@yuzur1ha/press-theme": "workspace:^",
    "@yuzur1ha/press-reference": "workspace:^"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@yuzur1ha/markdown": "workspace:*",
    "@yuzur1ha/press": "workspace:*",
    "ajv": "catalog:",
    "tailwindcss": "catalog:",
    "vite": "catalog:"
  },
  "imports": {
    "#docs/*": "./src/docs/*.ts"
