{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Component API documentation",
  "type": "object",
  "additionalProperties": false,
  "required": ["component", "parts"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "component": {
      "type": "string",
      "pattern": "^[a-z]+(?:-[a-z]+)*$"
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "typeName", "description", "props", "methods"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "typeName": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "props": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "type", "required", "description"],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "type": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "required": {
                  "type": "boolean"
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "default": {
                  "type": "string"
                }
              }
            }
          },
          "methods": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "signature", "description"],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "signature": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            }
          }
        }
      }
    }
  }
}
