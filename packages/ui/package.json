{
  "name": "@yuzur1ha/ui",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/entries/*.d.ts",
      "import": "./dist/entries/*.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "vite build && yu-build-declarations",
    "test": "pnpm -w test:unit --project=ui"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "1.3.1",
    "@radix-ui/react-collapsible": "1.2.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-form": "0.3.0",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-toast": "1.3.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@yuzur1ha/token": "workspace:^",
    "lucide-react": "1.61.0"
  },
  "devDependencies": {
    "@emotion/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "catalog:",
    "@yuzur1ha/shared": "workspace:^"
  },
  "version": "0.1.0",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "license": "MIT",
  "description": "Accessible React components with scoped design tokens.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soppylzz/yuzur1ha-oss.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/soppylzz/yuzur1ha-oss#readme",
  "bugs": {
    "url": "https://github.com/soppylzz/yuzur1ha-oss/issues"
  },
  "keywords": [
    "yuzur1ha",
    "typescript",
    "esm"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  }
}
