{
  "name": "@yuzur1ha/markdown",
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./compiler": {
      "types": "./dist/compiler/index.d.ts",
      "import": "./dist/compiler/index.js"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "import": "./dist/plugins/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts"
    }
  },
  "scripts": {
    "build": "vite build && yu-build-declarations --shim src/client.ts=client.d.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "pnpm -w test:unit --project=markdown"
  },
  "dependencies": {
    "@mdx-js/mdx": "3.1.1",
    "@types/estree": "1.0.9",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/unist": "3.0.3",
    "acorn": "8.19.0",
    "hast-util-to-string": "3.0.1",
    "mdast-util-gfm-table": "2.0.0",
    "mdast-util-mdx-jsx": "3.2.0",
    "mdast-util-to-hast": "13.2.1",
    "micromark-extension-gfm-table": "2.1.1",
    "rehype-raw": "7.0.0",
    "remark-directive": "4.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-parse": "11.0.0",
    "source-map": "0.7.6",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "vfile": "6.0.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "catalog:",
    "@yuzur1ha/shared": "workspace:^"
  },
  "license": "MIT",
  "description": "Markdown compilation, plugins and Vite transforms.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuzur1ha-org/react.git",
    "directory": "packages/markdown"
  },
  "homepage": "https://github.com/yuzur1ha-org/react#readme",
  "bugs": {
    "url": "https://github.com/yuzur1ha-org/react/issues"
  },
  "keywords": [
    "yuzur1ha",
    "typescript",
    "esm"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
