{
  "name": "@yuzur1ha/press",
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": false,
  "exports": {
    "./content": {
      "types": "./dist/content/index.d.ts",
      "import": "./dist/content/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js"
    },
    "./site": {
      "types": "./dist/site/index.d.ts",
      "import": "./dist/site/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build && node ../../scripts/build-declarations.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "pnpm -w test:unit --project=press"
  },
  "bin": {
    "yupress": "./bin/yupress.mjs"
  },
  "dependencies": {
    "@react-router/dev": "8.5.0",
    "@react-router/node": "8.5.0",
    "@yuzur1ha/markdown": "workspace:^",
    "jiti": "2.7.0",
    "mri": "1.2.0",
    "shiki": "4.6.0"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-router": {
      "optional": true
    }
  },
  "license": "MIT",
  "description": "Content services, CLI and static documentation builds.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soppylzz/yuzur1ha-oss.git",
    "directory": "packages/press"
  },
  "homepage": "https://github.com/soppylzz/yuzur1ha-oss#readme",
  "bugs": {
    "url": "https://github.com/soppylzz/yuzur1ha-oss/issues"
  },
  "keywords": [
    "yuzur1ha",
    "typescript",
    "esm"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  }
}
