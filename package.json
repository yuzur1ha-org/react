{
  "name": "yuzur1ha-oss",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "dev": "pnpm build:packages && pnpm --filter @yuzur1ha/docs dev",
    "build": "pnpm build:packages && pnpm --filter @yuzur1ha/docs build",
    "build:packages": "pnpm --filter \"./packages/*\" --if-present build",
    "build:docs": "pnpm build:packages && pnpm --filter @yuzur1ha/docs build",
    "content:generate": "pnpm --filter @yuzur1ha/docs content:generate",
    "content:check": "pnpm --filter @yuzur1ha/docs content:check",
    "check:prepare": "pnpm build:packages && pnpm content:generate",
    "check": "pnpm check:prepare && pnpm lint && pnpm typecheck:run && node scripts/verify-repository.mjs && pnpm format:check",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "pnpm check:prepare && pnpm typecheck:run",
    "typecheck:run": "tsc -p tsconfig.json && pnpm -r --if-present typecheck",
    "test": "pnpm test:unit",
    "test:unit": "pnpm check:prepare && vitest run && node --test scripts/tests/*.test.mjs",
    "test:e2e": "pnpm check:prepare && playwright test --project=docs:* && playwright test --project=docs-content:* && playwright test --project=docs-polish:*",
    "test:production": "pnpm build && playwright test --project=docs-production:* && playwright test --project=docs-polish-production:*",
    "test:package": "pnpm build:packages && node scripts/verify-packages.mjs",
    "test:ssg": "pnpm build:packages && node packages/press/tests/ssg/verify.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only --ignore-scripts",
    "release": "pnpm build:packages && node scripts/verify-packages.mjs && changeset publish",
    "lint:commits": "commitlint",
    "lint:staged": "lint-staged",
    "prepare": "husky",
    "hooks:init": "husky",
    "test:pages": "node scripts/verify-pages.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@eslint/js": "catalog:",
    "@eslint/json": "catalog:",
    "@eslint/markdown": "catalog:",
    "@playwright/test": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-jsx-a11y": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "globals": "catalog:",
    "husky": "catalog:",
    "jsdom": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:",
    "@changesets/cli": "catalog:",
    "@changesets/changelog-github": "catalog:",
    "vite": "catalog:",
    "@yuzur1ha/press-theme": "workspace:^",
    "@yuzur1ha/press-reference": "workspace:^",
    "yaml": "catalog:"
  }
}
