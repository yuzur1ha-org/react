{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx"
  },
  "include": ["*.mjs", "*.ts"],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "**/dist",
    "**/out",
    "**/.next",
    "**/coverage",
    ".local",
    ".husky"
  ]
}
